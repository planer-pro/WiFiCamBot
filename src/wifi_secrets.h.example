// Образец файла настроек. Скопируйте в wifi_secrets.h:
//   cp src/wifi_secrets.h.example src/wifi_secrets.h
// Сам wifi_secrets.h в .gitignore — в репозиторий не попадает.

// Сеть и пароль плата запоминает сама (WiFiManager, NVS): при первом включении
// или если сеть не находится — поднимается настроечная точка доступа с этим
// именем; подключитесь к ней с телефона/ноутбука и выберите свою сеть.
#define WIFI_AP_NAME "wificambot-setup"

// Необязательный пароль OTA-прошивки (ArduinoOTA). Закомментирован = прошить
// по WiFi сможет любой в вашей сети. Задайте пароль здесь и тогда же укажите
// upload_flags = --auth=ПАРОЛЬ в env «ota» файла platformio.ini.
// #define OTA_PASSWORD "OTA_CHANGE_ME"
