// Образец файла с данными WiFi. Скопируйте в wifi_secrets.h и впишите свои:
//   cp src/wifi_secrets.h.example src/wifi_secrets.h
// Сам wifi_secrets.h в .gitignore — пароль в репозиторий не попадает.
#define WIFI_SSID "SSID_CHANGE_ME"
#define WIFI_PASS "PASS_CHANGE_ME"

// Необязательный пароль OTA-прошивки (ArduinoOTA). Закомментирован = прошить
// по WiFi сможет любой в вашей сети. Задайте пароль здесь и тогда же укажите
// upload_flags = --auth=ПАРОЛЬ в env «ota» файла platformio.ini.
// #define OTA_PASSWORD "OTA_CHANGE_ME"
